# AI Video Clipper Bot - Environment Configuration
# Copy this file to .env and fill in your actual values

# ==========================================
# APP MODE: LOCAL or VPS
# LOCAL = Use Windows D: drive (via WSL mount /mnt/d/) for temp storage, medium render quality
# VPS   = Use /tmp/ for temp storage, auto cleanup, ultrafast render
APP_MODE=LOCAL

# ==========================================
# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ==========================================
# Google Gemini API (for video analysis / viral spotting)
# Get key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Groq API (for Whisper speech-to-text)
# Get key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# Optional: Max video duration in minutes (default: 120, max: 180)
MAX_VIDEO_DURATION_MINUTES=120

# Optional: Gemini max video duration in minutes (default: 120)
GEMINI_MAX_DURATION_MINUTES=120

# Optional: Gemini frame sampling interval in seconds (default: 5)
# Higher = fewer tokens but less detail. 1 = every second, 5 = every 5 seconds
GEMINI_FRAME_SAMPLING_INTERVAL=5

# Optional: Max file size in MB (default: 500)
MAX_FILE_SIZE_MB=500

# Optional: Concurrent render jobs (VPS mode, default: 2)
MAX_CONCURRENT_JOBS=2

# Optional: Gemini model name (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-3.6-flash

# Optional: Groq Whisper model (default: whisper-large-v3)
GROQ_WHISPER_MODEL=whisper-large-v3
